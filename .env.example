# Application
DEBUG=True
APP_NAME="Event Analytics & Reporting Platform"
APP_VERSION="1.0.0"

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/event_analytics

# Redis
REDIS_URL=redis://redis:6379/0

# AWS S3
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=us-east-1
S3_BUCKET_NAME=event-analytics-archive

# Cache TTL (seconds)
CACHE_TTL_DAILY=300
CACHE_TTL_MONTHLY=600
CACHE_TTL_SUMMARY=300
CACHE_TTL_TOP_SOURCES=300

# Archival
ARCHIVE_DAYS_THRESHOLD=90
